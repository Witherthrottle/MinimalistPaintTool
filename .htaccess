# The repo is served straight from public_html: hide everything that isn't the app or the API.
Options -Indexes
RedirectMatch 404 /\.git
RedirectMatch 404 /\.claude
RedirectMatch 404 ^/tools/
RedirectMatch 404 \.(md|py)$
RedirectMatch 404 /\.gitignore$

# Always revalidate the app shell so participants get updates
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|config\.local\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
